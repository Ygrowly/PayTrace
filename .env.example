# PayTrace environment template.
# Copy to `.env` and adjust. This file contains only non-sensitive defaults.
# Secrets and production values must come from real environment configuration.

# --- Runtime ---
# dev/test allow local defaults; staging/production reject development
# credentials, local Artifact storage, and non-HTTPS frontend origins.
APP_ENV=dev

# --- PostgreSQL (control plane) ---
POSTGRES_USER=paytrace
POSTGRES_PASSWORD=paytrace_dev
POSTGRES_DB=paytrace
# NOTE: default dev port is 54320 (not the conventional 5432) to avoid
# colliding with a locally installed PostgreSQL service on Windows. Docker
# forwards 54320 -> container 5432.
POSTGRES_PORT=54320
DATABASE_URL=postgresql+psycopg://paytrace:paytrace_dev@localhost:54320/paytrace

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- MinIO (artifact store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=paytrace
MINIO_SECRET_KEY=paytrace_dev_secret
MINIO_BUCKET=paytrace
MINIO_SECURE=false
ARTIFACT_STORE_BACKEND=local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Model provider ---
# Leave blank to run with RuleBasedModelAdapter (no API key needed).
MODEL_PROVIDER=rule_based
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:3000
# Browser-visible API origin, embedded when the frontend image is built.
NEXT_PUBLIC_PAYTRACE_API_BASE=http://localhost:8000
# JSON list consumed by pydantic-settings. Use the public API hostname in production.
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]

# --- Diagnostic Harness ---
TOOL_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS=8

# --- Celery ---
CELERY_CONCURRENCY=2

# --- SSE ---
SSE_MAX_CONNECTIONS=100
SSE_MAX_PER_RUN=10
SSE_HEARTBEAT_SECONDS=15
