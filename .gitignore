data/scenarios/*.parquet
data/scenarios/*.json
data/scenarios/**/*.parquet
data/scenarios/**/*.json
!data/scenarios/.gitkeep

# --- Local artifacts / traces ---
*.log
logs/
artifacts/
traces/
