# uv.lock is committed per § 5.4

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
.npm
.pnpm-store/

# Generated types are tracked (§ 27.1), so do NOT ignore:
# frontend/lib/api/schema.ts
# backend/openapi.json

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker volumes (local only) ---
postgres_data/
redis_data/
minio_data/

