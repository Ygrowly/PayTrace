# PayTrace frontend Dockerfile (Next.js workbench, plan § 25.2).
#
# Build:
#   docker build -f Dockerfile.frontend -t paytrace-frontend .
#
# Run:
#   docker run -p 3000:3000 paytrace-frontend

FROM node:22-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S paytrace && adduser -S paytrace -G paytrace
COPY --from=builder /app/package.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public 2>/dev/null || true
COPY --from=builder /app/node_modules ./node_modules
USER paytrace
EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
