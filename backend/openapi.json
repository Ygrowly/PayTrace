{
  "openapi": "3.1.0",
  "info": {
    "title": "PayTrace Backend",
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Live",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Ready",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ontology": {
      "get": {
        "tags": [
          "ontology"
        ],
        "summary": "Get Ontology",
        "operationId": "get_ontology_api_v1_ontology_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OntologyPlaceholder"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DependencyStatus"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LivenessResponse"
      },
      "OntologyPlaceholder": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "version",
          "note"
        ],
        "title": "OntologyPlaceholder"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "type": "object",
            "title": "Dependencies"
          }
        },
        "type": "object",
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadinessResponse"
      }
    }
  }
}
