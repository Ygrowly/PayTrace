{
  "name": "paytrace-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "PayTrace Next.js workbench for incidents, diagnosis traces, and evaluation runs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
