    "gen:api": "openapi-typescript ../backend/openapi.json -o lib/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "echarts": "^6.1.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.18.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.6.1",
    "postcss": "8.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.18.0"
  },
